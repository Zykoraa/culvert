[Unit]
Description=Culvert tunnel for user %i
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/culvert/linux/host.py %i
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=5
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/culvert /var/lib/culvert
PrivateTmp=true
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
